{
    "name": "shipmonk/passkeys",
    "description": "Passkeys (WebAuthn) library for PHP with zero dependencies",
    "license": "MIT",
    "keywords": [
        "authentication",
        "fido2",
        "passkeys",
        "passwordless",
        "security",
        "webauthn"
    ],
    "require": {
        "php": ">=8.4",
        "ext-openssl": "*"
    },
    "require-dev": {
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3.3",
        "doctrine/orm": "^3.7.5",
        "ergebnis/composer-normalize": "^2.54",
        "infection/infection": "^0.35.8",
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4.3",
        "shipmonk/coding-standard": "^0.3.0",
        "shipmonk/coverage-guard": "^1.2.0",
        "shipmonk/dead-code-detector": "^1.4.2",
        "shipmonk/phpstan-rules": "^4.4.1",
        "symfony/framework-bundle": "^8.1.9",
        "symfony/runtime": "^8.1.9"
    },
    "autoload": {
        "psr-4": {
            "ShipMonk\\Passkeys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShipMonk\\PasskeysSymfonyDemo\\": "example/symfony/src/",
            "ShipMonk\\PasskeysTests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "check": [
            "@check:composer",
            "@check:cs",
            "@check:types",
            "@check:coverage",
            "@check:mutations"
        ],
        "check:composer": [
            "composer normalize --dry-run --no-update-lock",
            "composer validate --strict"
        ],
        "check:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit tests --coverage-clover cache/clover.xml",
            "coverage-guard check cache/clover.xml"
        ],
        "check:cs": "phpcs",
        "check:mutations": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max --no-interaction"
        ],
        "check:tests": "phpunit",
        "check:types": "phpstan analyse -vv --ansi",
        "fix:cs": "phpcbf"
    }
}
