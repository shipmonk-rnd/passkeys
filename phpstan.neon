includes:
  - phar://phpstan.phar/conf/bleedingEdge.neon
  - vendor/phpstan/phpstan-phpunit/extension.neon
  - vendor/phpstan/phpstan-phpunit/rules.neon
  - vendor/phpstan/phpstan-strict-rules/rules.neon
  - vendor/shipmonk/dead-code-detector/rules.neon
  - vendor/shipmonk/phpstan-rules/rules.neon

parameters:
  level: max
  checkUninitializedProperties: true
  checkMissingCallableSignature: true
  reportAnyTypeWideningInVarTag: true
  reportPossiblyNonexistentConstantArrayOffset: true
  reportPossiblyNonexistentGeneralArrayOffset: true

  phpVersion:
    min: 80100
    max: 80500

  paths:
    - coverage-guard.php
    - src
    - tests

  exceptions:
    check:
      missingCheckedExceptionInThrows: true
      tooWideThrowType: true
      throwTypeCovariance: true
    implicitThrows: false
    checkedExceptionClasses:
      - RuntimeException

  shipmonkDeadCode:
    usageExcluders:
      tests:
        enabled: true

  shipmonkRules:
    forbidCast:
      enabled: false

  ignoreErrors:
    # PHP 8.1 has no asymmetric visibility (`public private(set)`): these properties carry
    # @phpstan-readonly-allow-private-mutation instead, which this rule does not recognise.
    - identifier: shipmonk.publicPropertyNotReadonly
      paths:
        - src/Testing/FakePasskey.php
        - tests/InMemoryPasskeyStore.php
        - tests/InMemoryPendingCeremonyStore.php
    - identifier: missingType.checkedException
      path: tests/*
    - identifier: staticMethod.alreadyNarrowedType
      path: tests/*
